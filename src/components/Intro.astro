---
// 开场 flash：银幕直接亮起（不做推入）→ 打字机欢迎语 → ASCII 双手相握
//（致敬诺基亚 Connecting People：大人手 + 小孩手，靠近→轻触→扣握）
// → 字符散开聚成头像 → 银幕交还页面，左右胶片导轨浮现。
// 每会话只放一次（Base 头部内联标记 data-intro="pending"），
// 任意点击/滚动/按键跳过；reduced-motion 用户根本不会进入 pending 状态。
---

<div class="intro-overlay" id="intro-overlay" aria-hidden="true">
  <div class="io-screen" id="io-screen">
    <canvas id="io-canvas"></canvas>
  </div>
  <p class="io-skip">点击任意处入场 →</p>
</div>

<style>
  .intro-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 80;
    background: var(--theater);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
  }
  :global(html[data-intro='pending']) .intro-overlay { display: flex; }
  .intro-overlay.bye { opacity: 0; transition: opacity 0.42s ease; pointer-events: none; }
  /* 银幕直接就位，只给一个很短的亮灯淡入——不做窗口推入 */
  .io-screen {
    width: min(880px, 92vw);
    height: min(520px, 64vh);
    background: linear-gradient(165deg, var(--screen-a), var(--screen-b));
    border: 1px solid var(--panel-line);
    position: relative;
    overflow: hidden;
    opacity: 0;
    animation: ioFade 0.28s ease 0.08s forwards;
  }
  @keyframes ioFade { to { opacity: 1; } }
  #io-canvas { display: block; width: 100%; height: 100%; }
  .io-skip {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--rail-dim);
  }
</style>

<script>
  import asciiData from '../data/avatar-ascii.json';
  import handsData from '../data/hands-ascii.json';

  const rootEl = document.documentElement;
  const overlay = document.getElementById('intro-overlay');

  if (rootEl.dataset.intro === 'pending' && overlay) {
    const screenBox = document.getElementById('io-screen')!;
    const canvas = document.getElementById('io-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    const MONO = 'Consolas, Menlo, monospace';
    let w = 0, h = 0, raf = 0, finished = false;
    const start = performance.now();

    // 主题色（跟随明暗主题）
    const css = getComputedStyle(rootEl);
    const PINK = css.getPropertyValue('--pink').trim() || '#ee6fa4';
    const INK = css.getPropertyValue('--ink').trim() || '#14333b';

    function resize() {
      w = screenBox.clientWidth;
      h = screenBox.clientHeight;
      canvas.width = Math.round(w * DPR);
      canvas.height = Math.round(h * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    }
    resize();
    window.addEventListener('resize', resize);

    // ---- 头像目标形态（与 AsciiAvatar 同一套裁剪逻辑） ----
    const art: string[] = (asciiData as { rows: string[] }).rows;
    let r0 = art.length, r1 = -1, c0 = Infinity, c1 = -1;
    art.forEach((row, r) => {
      for (let c = 0; c < row.length; c++) {
        if (row[c] !== ' ') {
          if (r < r0) r0 = r;
          if (r > r1) r1 = r;
          if (c < c0) c0 = c;
          if (c > c1) c1 = c;
        }
      }
    });
    const cropped = art.slice(r0, r1 + 1).map((row) => row.slice(c0, c1 + 1));
    const cols = c1 - c0 + 1, rowsN = cropped.length;

    // ---- 握手帧：150 列 x 30 行，col 95 分成左右两半（大手 / 小手），滑入时各自带位移 ----
    const HANDS: string[][] = (handsData as { frames: string[][] }).frames;
    const HC = HANDS[0][0].length, HR = HANDS[0].length;
    const SPLIT = 95;
    let hfs = 0, hox = 0, hoy = 0;
    function handsLayout() {
      hfs = Math.min(w / (HC * 0.62), (h * 0.66) / (HR * 1.12));
      hox = (w - HC * hfs * 0.62) / 2;
      hoy = h / 2 - (HR * hfs * 1.12) / 2 + hfs * 0.8;
      ctx.font = hfs + 'px ' + MONO;
    }
    function drawHands(fi: number, dxL: number, dxR: number, dy = 0) {
      ctx.fillStyle = INK;
      const cw = hfs * 0.62, chh = hfs * 1.12;
      const f = HANDS[Math.min(fi, HANDS.length - 1)];
      for (let r = 0; r < f.length; r++) {
        const row = f[r];
        const left = row.slice(0, SPLIT).replace(/\s+$/, '');
        const right = row.slice(SPLIT);
        if (left) ctx.fillText(left, hox + dxL, hoy + r * chh + dy);
        if (right.trim()) ctx.fillText(right, hox + SPLIT * cw + dxR, hoy + r * chh + dy);
      }
    }

    // ---- 粒子目标：头像每个字符的落点 ----
    type Particle = { ch: string; tx: number; ty: number; sx: number; sy: number; delay: number };
    let particles: Particle[] = [];
    function buildParticles() {
      const fs = Math.max(5, Math.min(w / (cols * 0.62), (h / rowsN) / 1.3));
      const cellW = fs * 0.62, cellH = fs * 1.12;
      const ox = (w - cols * cellW) / 2, oy = (h - rowsN * cellH) / 2;
      particles = [];
      for (let r = 0; r < rowsN; r++) {
        for (let c = 0; c < cropped[r].length; c++) {
          const ch = cropped[r][c];
          if (ch === ' ') continue;
          particles.push({
            ch,
            tx: ox + c * cellW, ty: oy + r * cellH + fs * 0.8,
            sx: w / 2 + (Math.random() - 0.5) * 90,
            sy: h / 2 + (Math.random() - 0.5) * 50,
            delay: Math.random() * 0.35,
          });
        }
      }
      ctx.font = fs + 'px ' + MONO;
    }

    const WELCOME = '欢迎来到 B-TV 放映室';
    const CAPTION = '· CONNECTING PEOPLE ·';
    const easeOut = (p: number) => 1 - Math.pow(1 - p, 3);

    function frame() {
      if (finished) return;
      const t = (performance.now() - start) / 1000;
      // 银幕底色与渐变同步（清屏）
      const g = ctx.createLinearGradient(0, 0, w * 0.4, h);
      g.addColorStop(0, css.getPropertyValue('--screen-a').trim() || '#a9dcd0');
      g.addColorStop(1, css.getPropertyValue('--screen-b').trim() || '#8cc9b9');
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, w, h);

      if (t < 1.2) {
        // 第一幕：打字机欢迎语（同款粉色字）
        ctx.font = '20px ' + MONO;
        ctx.fillStyle = PINK;
        const n = Math.floor(Math.max(0, t - 0.3) / 0.07);
        const txt = WELCOME.slice(0, n);
        ctx.fillText(txt + (Math.floor(t * 3) % 2 ? '_' : ''), w / 2 - ctx.measureText(WELCOME).width / 2, h / 2);
      } else if (t < 3.0) {
        // 第二幕：双手相握（帧 0 滑入 → 轻触 → 扣握+一抖）
        handsLayout();
        const a = Math.min(1, (t - 1.2) / 0.45);
        const slide = (1 - easeOut(a)) * (w * 0.28);
        let fi = 0, dy = 0;
        if (t > 2.05) fi = 1;
        if (t > 2.45) {
          fi = 2;
          if (t < 2.75) dy = Math.floor((t - 2.45) * 16) % 2 ? 2.5 : -2.5; // 扣住的轻轻一抖
        }
        drawHands(fi, -slide, slide, dy);
        // 小字副标：握手相扣时打字出现
        if (t > 2.45) {
          ctx.font = '12px ' + MONO;
          ctx.fillStyle = PINK;
          const m = Math.floor((t - 2.45) / 0.05);
          const cpt = CAPTION.slice(0, m);
          ctx.fillText(cpt, w / 2 - ctx.measureText(CAPTION).width / 2, hoy + HR * hfs * 1.12 + 26);
        }
      } else {
        // 第三幕：字符散开，吸附成头像
        if (!particles.length) buildParticles();
        const gt = t - 3.0;
        ctx.fillStyle = INK;
        for (const p of particles) {
          const lp = Math.max(0, Math.min(1, (gt - p.delay) / 0.85));
          const e = easeOut(lp);
          const x = p.sx + (p.tx - p.sx) * e;
          const y = p.sy + (p.ty - p.sy) * e;
          ctx.globalAlpha = 0.25 + 0.75 * e;
          ctx.fillText(p.ch, x, y);
        }
        ctx.globalAlpha = 1;
        if (gt > 1.5) finish(); // 自然播完
      }
      raf = requestAnimationFrame(frame);
    }

    function finish() {
      if (finished) return;
      finished = true;
      cancelAnimationFrame(raf);
      rootEl.dataset.intro = 'done';
      overlay!.classList.add('bye');
      window.setTimeout(() => overlay!.remove(), 440);
      // 落座后：关于我标题/副标题打字机，kv 行错落浮现（导轨由 CSS 过渡推入）
      const kvs = document.querySelectorAll<HTMLElement>('.scene-intro .kv');
      kvs.forEach((el, i) => { el.style.transitionDelay = `${i * 70}ms`; });
      const title = document.querySelector<HTMLElement>('.scene-intro .s-title');
      const sub = document.querySelector<HTMLElement>('.scene-intro .s-sub');
      if (title && sub) {
        const full = sub.textContent || '';
        sub.textContent = '';
        window.setTimeout(() => {
          let i = 0;
          const timer = window.setInterval(() => {
            sub.textContent = full.slice(0, ++i) + (i < full.length ? '_' : '');
            if (i >= full.length) window.clearInterval(timer);
          }, 26);
        }, 450);
      }
    }

    // 任意输入跳过
    ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach((ev) =>
      window.addEventListener(ev, finish, { once: true, passive: true })
    );
    raf = requestAnimationFrame(frame);
  }
</script>
