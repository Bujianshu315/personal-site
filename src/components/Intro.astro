---
// 开场（极简版）：放映厅就位、银幕全黑 → 银幕渐渐亮起 →
// 粉色打字机「欢迎来到 B-TV 放映室」→ 停留片刻 →
// 左右胶片导轨与页面内容落座（字幕打字机 + 信息行错落浮现）。
// 每会话只放一次（Base 头部内联标记 data-intro="pending"），
// 任意点击/滚动/按键立即入场；reduced-motion 用户根本不会进入 pending。
---

<div class="intro-overlay" id="intro-overlay" aria-hidden="true">
  <p class="io-welcome" id="io-welcome"></p>
  <p class="io-skip">点击任意处入场 →</p>
</div>

<style>
  /* 覆盖在银幕内部（.screen 内绝对定位），黑场 → 透明 = 银幕渐渐明亮 */
  .intro-overlay {
    display: none;
    position: absolute;
    inset: 0;
    z-index: 30;
    background: #000;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
  }
  :global(html[data-intro='pending']) .intro-overlay {
    display: flex;
    animation: ioBright 1.1s ease 0.15s forwards;
  }
  @keyframes ioBright {
    to { background: transparent; }
  }
  .intro-overlay.bye { opacity: 0; transition: opacity 0.42s ease; pointer-events: none; }

  .io-welcome {
    margin: 0;
    min-height: 1.5em;
    font-family: 'FusionPixel', ui-monospace, Consolas, monospace;
    font-size: clamp(18px, 2.6vw, 28px);
    letter-spacing: 0.1em;
    color: var(--pink);
    text-shadow: 0 0 18px rgba(238, 111, 164, 0.35);
  }
  .io-welcome .cur { animation: ioBlink 0.75s steps(1) infinite; }
  @keyframes ioBlink { 50% { opacity: 0; } }

  .io-skip {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--ink-soft);
    opacity: 0.75;
  }
</style>

<script>
  const rootEl = document.documentElement;
  const overlay = document.getElementById('intro-overlay');

  if (rootEl.dataset.intro === 'pending' && overlay) {
    const WELCOME = '欢迎来到 B-TV 放映室';
    const el = document.getElementById('io-welcome')!;
    let finished = false;
    let timer = 0;

    function finish() {
      if (finished) return;
      finished = true;
      window.clearInterval(timer);
      rootEl.dataset.intro = 'done';
      overlay!.classList.add('bye');
      window.setTimeout(() => overlay!.remove(), 460);
      // 落座后：kv 行错落浮现 + 关于我副标题打字机（导轨/横幅由 CSS 过渡推入）
      const kvs = document.querySelectorAll<HTMLElement>('.scene-intro .kv');
      kvs.forEach((kv, i) => { kv.style.transitionDelay = `${i * 60}ms`; });
      const sub = document.querySelector<HTMLElement>('.scene-intro .s-sub');
      if (sub) {
        const full = sub.textContent || '';
        sub.textContent = '';
        window.setTimeout(() => {
          let i = 0;
          const t2 = window.setInterval(() => {
            sub.textContent = full.slice(0, ++i) + (i < full.length ? '_' : '');
            if (i >= full.length) window.clearInterval(t2);
          }, 26);
        }, 500);
      }
    }

    // 等像素字体就绪（最多等 500ms），银幕亮起后（0.9s）开始打字机
    try { document.fonts?.load('16px FusionPixel', WELCOME); } catch {}
    window.setTimeout(() => {
      if (finished) return;
      let i = 0;
      timer = window.setInterval(() => {
        i++;
        el.innerHTML =
          WELCOME.slice(0, i).replace(/</g, '&lt;') + '<span class="cur">_</span>';
        if (i >= WELCOME.length) {
          window.clearInterval(timer);
          window.setTimeout(finish, 1000); // 完整文案停留片刻再落座
        }
      }, 90);
    }, 900);

    // 任意输入跳过；6 秒兜底无论如何结束
    ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach((ev) =>
      window.addEventListener(ev, finish, { once: true, passive: true })
    );
    window.setTimeout(finish, 6000);
  }
</script>
