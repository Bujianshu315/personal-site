---
// 开场 flash：黑场 → 银幕推入+打字机欢迎 → ASCII 握手（诺基亚）→ 字符散开聚成头像 → 亮灯落座
// 每会话只放一次（sessionStorage 由 Base 头部内联脚本标记 data-intro="pending"），
// 任意点击/滚动/按键跳过；reduced-motion 用户根本不会进入 pending 状态。
---

<div class="intro-overlay" id="intro-overlay" aria-hidden="true">
  <div class="io-screen" id="io-screen">
    <canvas id="io-canvas"></canvas>
  </div>
  <p class="io-skip">点击任意处入场 →</p>
</div>

<style>
  .intro-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 80;
    background: #04070a;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
  }
  :global(html[data-intro='pending']) .intro-overlay { display: flex; }
  .intro-overlay.bye { opacity: 0; transition: opacity 0.38s ease; pointer-events: none; }
  .io-screen {
    width: min(720px, 88vw);
    height: min(440px, 62vh);
    background: #0a2228;
    border: 1px solid #1d4a52;
    position: relative;
    overflow: hidden;
  }
  #io-canvas { display: block; width: 100%; height: 100%; }
  .io-skip {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: #4d5d67;
  }
</style>

<script>
  import asciiData from '../data/avatar-ascii.json';

  const rootEl = document.documentElement;
  const overlay = document.getElementById('intro-overlay');

  if (rootEl.dataset.intro === 'pending' && overlay) {
    const screenBox = document.getElementById('io-screen')!;
    const canvas = document.getElementById('io-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    const MONO = 'Consolas, Menlo, monospace';
    const PINK = '#ee6fa4';
    const MINT = 'rgba(143,224,205,0.92)';
    let w = 0, h = 0, raf = 0, finished = false;
    const start = performance.now();

    function resize() {
      w = screenBox.clientWidth;
      h = screenBox.clientHeight;
      canvas.width = Math.round(w * DPR);
      canvas.height = Math.round(h * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    }
    resize();
    window.addEventListener('resize', resize);

    // ---- 头像目标形态（与 AsciiAvatar 同一套裁剪逻辑） ----
    const art: string[] = (asciiData as { rows: string[] }).rows;
    let r0 = art.length, r1 = -1, c0 = Infinity, c1 = -1;
    art.forEach((row, r) => {
      for (let c = 0; c < row.length; c++) {
        if (row[c] !== ' ') {
          if (r < r0) r0 = r;
          if (r > r1) r1 = r;
          if (c < c0) c0 = c;
          if (c > c1) c1 = c;
        }
      }
    });
    const cropped = art.slice(r0, r1 + 1).map((row) => row.slice(c0, c1 + 1));
    const cols = c1 - c0 + 1, rowsN = cropped.length;

    // ---- 诺基亚握手：字符帧动画 ----
    const HANDS = [
      '>>==                  ==<<',
      ' >>===              ===<<',
      '  >>====          ====<<',
      '   >>=====      =====<<',
      '    >>=====@@=====<<',
      '    >>=====@@=====<<',
    ];

    // ---- 粒子目标：头像每个字符的落点 ----
    type Particle = { ch: string; tx: number; ty: number; sx: number; sy: number; delay: number };
    let particles: Particle[] = [];
    function buildParticles() {
      const fs = Math.max(5, Math.min(w / (cols * 0.62), (h / rowsN) / 1.3));
      const cellW = fs * 0.62, cellH = fs * 1.12;
      const ox = (w - cols * cellW) / 2, oy = (h - rowsN * cellH) / 2;
      particles = [];
      for (let r = 0; r < rowsN; r++) {
        for (let c = 0; c < cropped[r].length; c++) {
          const ch = cropped[r][c];
          if (ch === ' ') continue;
          particles.push({
            ch,
            tx: ox + c * cellW, ty: oy + r * cellH + fs * 0.8,
            sx: w / 2 + (Math.random() - 0.5) * 90,
            sy: h / 2 + (Math.random() - 0.5) * 50,
            delay: Math.random() * 0.35,
          });
        }
      }
      ctx.font = fs + 'px ' + MONO;
    }

    const WELCOME = '欢迎来到 B-TV 放映室';
    const easeOut = (p: number) => 1 - Math.pow(1 - p, 3);

    function frame() {
      if (finished) return;
      const t = (performance.now() - start) / 1000;
      ctx.fillStyle = '#0a2228';
      ctx.fillRect(0, 0, w, h);

      if (t < 0.95) {
        // 第一幕：银幕推入 + 打字机欢迎语
        const p = Math.min(1, t / 0.5);
        screenBox.style.transform = `scale(${0.94 + 0.06 * easeOut(p)})`;
        screenBox.style.opacity = String(Math.min(1, t / 0.3));
        ctx.font = '20px ' + MONO;
        ctx.fillStyle = PINK;
        const n = Math.floor(Math.max(0, t - 0.25) / 0.055);
        const txt = WELCOME.slice(0, n);
        ctx.fillText(txt + (Math.floor(t * 3) % 2 ? '_' : ' '), w / 2 - ctx.measureText(WELCOME).width / 2, h / 2);
      } else if (t < 2.15) {
        // 第二幕：握手
        screenBox.style.transform = ''; screenBox.style.opacity = '1';
        ctx.font = '18px ' + MONO;
        const fi = Math.min(HANDS.length - 1, Math.floor((t - 0.95) / 0.18));
        const shake = fi === HANDS.length - 1 ? (Math.floor(t * 14) % 2 ? 3 : -3) : 0;
        ctx.fillStyle = PINK;
        const line = HANDS[fi];
        ctx.fillText(line, w / 2 - ctx.measureText(line).width / 2, h / 2 + shake);
      } else {
        // 第三幕：字符散开，吸附成头像
        if (!particles.length) buildParticles();
        const gt = t - 2.15;
        ctx.fillStyle = MINT;
        for (const p of particles) {
          const lp = Math.max(0, Math.min(1, (gt - p.delay) / 0.85));
          const e = easeOut(lp);
          const x = p.sx + (p.tx - p.sx) * e;
          const y = p.sy + (p.ty - p.sy) * e;
          ctx.globalAlpha = 0.25 + 0.75 * e;
          ctx.fillText(p.ch, x, y);
        }
        ctx.globalAlpha = 1;
        if (gt > 1.45) finish(); // 自然播完
      }
      raf = requestAnimationFrame(frame);
    }

    function finish() {
      if (finished) return;
      finished = true;
      cancelAnimationFrame(raf);
      rootEl.dataset.intro = 'done';
      overlay!.classList.add('bye');
      window.setTimeout(() => overlay!.remove(), 420);
      // 落座后：关于我标题/副标题打字机，kv 行错落浮现
      const kvs = document.querySelectorAll<HTMLElement>('.scene-intro .kv');
      kvs.forEach((el, i) => { el.style.transitionDelay = `${i * 70}ms`; });
      const title = document.querySelector<HTMLElement>('.scene-intro .s-title');
      const sub = document.querySelector<HTMLElement>('.scene-intro .s-sub');
      if (title && sub) {
        const full = sub.textContent || '';
        sub.textContent = '';
        window.setTimeout(() => {
          let i = 0;
          const timer = window.setInterval(() => {
            sub.textContent = full.slice(0, ++i) + (i < full.length ? '_' : '');
            if (i >= full.length) window.clearInterval(timer);
          }, 26);
        }, 450);
      }
    }

    // 任意输入跳过
    ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach((ev) =>
      window.addEventListener(ev, finish, { once: true, passive: true })
    );
    raf = requestAnimationFrame(frame);
  }
</script>
