---
// ASCII 头像（构建时由 scripts/png2ascii.mjs 从 public/avatar.png 生成）
// 反相磷光小 CRT：深青底 + 薄荷绿辉光——大银幕（投影幕，亮底深图）的"暗面"。
// 渲染不用字符字体：数据 5 级梯度全部映射为矩形色块（fillRect），
// 手机等缺块字符字形的环境也不会错位乱码。底网 = 低透明度点阵。
interface Props {
  prompt?: string;
  height?: number;
}
const { prompt = 'bujianshu@sz ~ $', height = 190 } = Astro.props;
---

<div class="aa-wrap">
  <canvas id="ascii-avatar" role="img" aria-label="ASCII 头像：由头像图转换的字符画" style={`height:${height}px`}></canvas>
  <div class="aa-scan" aria-hidden="true"></div>
  <div class="aa-sweep" aria-hidden="true"></div>
  <span class="aa-prompt">{prompt}</span>
</div>

<style>
  .aa-wrap {
    position: relative;
    /* 小 CRT 自己发光：不随明暗主题反相，永远"开着机" */
    --aa-bg: #0e2a32;
    --aa-glow: #a9ecd9;
    background: var(--aa-bg);
    border: 1px solid var(--panel-line);
    border-radius: 0;
    overflow: hidden;
  }
  #ascii-avatar {
    display: block;
    width: 100%;
    height: 190px;
  }
  /* CRT 扫描线 */
  .aa-scan {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.22) 0 1px, transparent 1px 3px);
  }
  /* 缓慢下扫的光带（电视刷新感） */
  .aa-sweep {
    position: absolute;
    left: 0;
    right: 0;
    top: -22%;
    height: 20%;
    z-index: 3;
    pointer-events: none;
    background: linear-gradient(180deg, transparent, rgba(169, 236, 217, 0.13) 55%, transparent);
    animation: aaSweep 7s linear infinite;
  }
  @keyframes aaSweep {
    0% { top: -22%; }
    100% { top: 108%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .aa-sweep { animation: none; }
  }
  .aa-prompt {
    position: absolute;
    left: 8px;
    bottom: 6px;
    z-index: 4;
    font-size: 10px;
    color: var(--aa-glow);
    opacity: 0.65;
    padding: 2px 6px;
    border-radius: 0;
    pointer-events: none;
    text-shadow: 0 0 8px rgba(169, 236, 217, 0.5);
  }
</style>

<script>
  import asciiData from '../data/avatar-ascii.json';

  const wrap = document.querySelector('.aa-wrap');
  const canvas = document.getElementById('ascii-avatar') as HTMLCanvasElement | null;
  if (wrap && canvas && canvas.getContext) {
    const ctx = canvas.getContext('2d')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    const art: string[] = (asciiData as { rows: string[] }).rows;

    // 数据是整版网格：'.'=底网标记，' '=熄灭（头发/黑条剪影），░▒▓█=发光梯度
    const cols = art[0].length;
    const rowsN = art.length;
    // 梯度 → 透明度（矩形色块，无字体依赖）
    const LEVEL: Record<string, number> = { '░': 0.38, '▒': 0.62, '▓': 0.82, '█': 1 };

    // 终端字符格宽高比约 1:1.9，保持比例居中，不随画布拉伸
    let w = 0, h = 0, cellW = 0, cellH = 0, ox = 0, oy = 0, bootT: number | null = null;

    function resize() {
      w = wrap!.clientWidth;
      h = canvas!.clientHeight || 190;
      canvas!.width = Math.max(1, Math.round(w * DPR));
      canvas!.height = Math.max(1, Math.round(h * DPR));
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      const cw = w / cols;
      const ch = h / rowsN;
      if (cw * 1.9 <= ch) { cellW = cw; cellH = cw * 1.9; }   // 受宽度约束
      else { cellH = ch; cellW = ch / 1.9; }                  // 受高度约束
      ox = (w - cols * cellW) / 2;
      oy = (h - rowsN * cellH) / 2;
      draw(null);
    }

    // 返回 true = 开机显影动画播完，可以停止逐帧重绘
    function draw(t: number | null): boolean {
      if (!w || !h || !rowsN) return true;
      const styles = getComputedStyle(wrap!);
      const glow = styles.getPropertyValue('--aa-glow').trim() || '#a9ecd9';

      ctx.clearRect(0, 0, w, h);

      // 1) 底网：整版铺满低透明度点阵——磷光屏的"点亮底噪"
      ctx.fillStyle = glow;
      ctx.globalAlpha = 0.15;
      const gap = 0.5; // 块间微缝，模拟荧光粉颗粒
      const colsP = Math.ceil(w / cellW) + 1;
      const rowsP = Math.ceil(h / cellH) + 1;
      const x0 = Math.min(0, ox), y0 = Math.min(0, oy);
      for (let r = 0; r < rowsP; r++) {
        for (let c = 0; c < colsP; c++) {
          ctx.fillRect(
            x0 + c * cellW + gap, y0 + r * cellH + gap,
            Math.max(1, cellW - gap * 2), Math.max(1, cellH * 0.45)
          );
        }
      }
      ctx.globalAlpha = 1;

      // 2) 暗部熄灭：数据里的空格（头发/黑条）把底网擦掉 -> 比背景更暗的剪影
      for (let r = 0; r < rowsN; r++) {
        const row = art[r];
        for (let c = 0; c < row.length; c++) {
          if (row[c] === ' ') {
            ctx.clearRect(ox + c * cellW, oy + r * cellH, cellW + 0.6, cellH + 0.6);
          }
        }
      }

      // 3) 发光体：脸 = 实心块梯度（头发/黑条已在上面熄灭成剪影）
      let maxRow = rowsN;
      let done = true;
      if (t !== null && !reduced) {
        if (bootT === null) bootT = t;
        const p = Math.min(1, (t - bootT) / 0.9);
        maxRow = Math.ceil(p * rowsN);
        done = p >= 1;
      }
      ctx.fillStyle = glow;
      ctx.shadowColor = glow;
      ctx.shadowBlur = Math.min(10, cellW * 0.6);
      for (let r = 0; r < maxRow; r++) {
        const row = art[r];
        for (let c = 0; c < row.length; c++) {
          const a = LEVEL[row[c]];
          if (!a) continue;
          ctx.globalAlpha = a;
          ctx.fillRect(ox + c * cellW, oy + r * cellH, cellW + 0.5, cellH + 0.5);
        }
      }
      ctx.globalAlpha = 1;
      ctx.shadowBlur = 0;
      return done;
    }

    if (!reduced) {
      (function loop() {
        const done = draw(performance.now() / 1000);
        if (!done) requestAnimationFrame(loop);
      })();
    }
    if (window.ResizeObserver) new ResizeObserver(resize).observe(wrap!);
    resize();
  }
</script>
