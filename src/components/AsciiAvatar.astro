---
// ASCII 头像（构建时由 scripts/png2ascii.mjs 从 public/avatar.png 生成）
// 无黑底：字符点阵铺满画框（暗点 = 空位），亮色字符构成头像，自动裁剪居中
interface Props {
  prompt?: string;
}
const { prompt = 'bujianshu@sz ~ $' } = Astro.props;
---

<div class="aa-wrap">
  <canvas id="ascii-avatar" role="img" aria-label="ASCII 头像：由头像图转换的字符画"></canvas>
  <span class="aa-prompt">{prompt}</span>
</div>

<style>
  .aa-wrap {
    position: relative;
    background: transparent;   /* 不再用黑底：头像直接长在银幕上 */
    border: 1px solid var(--frame);
    border-radius: 0;
    overflow: hidden;
  }
  #ascii-avatar {
    display: block;
    width: 100%;
    height: 190px;
  }
  .aa-prompt {
    position: absolute;
    left: 8px;
    bottom: 6px;
    z-index: 2;
    font-size: 10px;
    color: var(--ink-soft);
    opacity: 0.8;
    padding: 2px 6px;
    border-radius: 0;
    pointer-events: none;
  }
</style>

<script>
  import asciiData from '../data/avatar-ascii.json';

  const wrap = document.querySelector('.aa-wrap');
  const canvas = document.getElementById('ascii-avatar') as HTMLCanvasElement | null;
  if (wrap && canvas && canvas.getContext) {
    const ctx = canvas.getContext('2d')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    const MONO = 'Consolas, Menlo, monospace';
    const art: string[] = (asciiData as { rows: string[] }).rows;

    // 裁剪头像的有效包围盒：去掉四周空白行列，居中才不再偏
    let r0 = art.length, r1 = -1, c0 = Infinity, c1 = -1;
    art.forEach((row, r) => {
      for (let c = 0; c < row.length; c++) {
        if (row[c] !== ' ') {
          if (r < r0) r0 = r;
          if (r > r1) r1 = r;
          if (c < c0) c0 = c;
          if (c > c1) c1 = c;
        }
      }
    });
    const cropped = art.slice(r0, r1 + 1).map((row) => row.slice(c0, c1 + 1));
    const cols = c1 - c0 + 1;
    const rowsN = cropped.length;

    let w = 0, h = 0, bootT: number | null = null;

    function resize() {
      w = wrap!.clientWidth;
      h = canvas!.clientHeight || 190;
      canvas!.width = Math.max(1, Math.round(w * DPR));
      canvas!.height = Math.max(1, Math.round(h * DPR));
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      draw(null);
    }

    function draw(t: number | null) {
      if (!w || !h || !rowsN) return;
      ctx.clearRect(0, 0, w, h);
      const styles = getComputedStyle(wrap!);
      const ink = styles.getPropertyValue('--ink').trim() || '#14333b';
      const inkSoft = styles.getPropertyValue('--ink-soft').trim() || '#2e5a62';
      const fs = Math.max(4, Math.min(w / (cols * 0.62), (h / rowsN) / 1.12));
      const cellW = fs * 0.62;
      const cellH = fs * 1.12;
      const ox = (w - cols * cellW) / 2;
      const oy = (h - rowsN * cellH) / 2;
      ctx.font = fs + 'px ' + MONO;
      ctx.textBaseline = 'alphabetic';

      // 字符点阵底：整个画框铺满暗点（·），头像从点阵里"显影"出来
      ctx.fillStyle = inkSoft;
      ctx.globalAlpha = 0.10;
      const dotRows = Math.floor(h / cellH);
      const dotCols = Math.floor(w / cellW);
      const dox = (w - dotCols * cellW) / 2;
      const doy = (h - dotRows * cellH) / 2;
      for (let r = 0; r < dotRows; r++) {
        const line = '·'.repeat(dotCols);
        ctx.fillText(line, dox, doy + r * cellH + fs * 0.8);
      }
      ctx.globalAlpha = 1;

      let maxRow = rowsN;
      if (t !== null) {
        if (bootT === null) bootT = t;
        maxRow = Math.ceil(Math.min(1, (t - bootT) / 0.9) * rowsN);
      }
      ctx.fillStyle = ink;
      ctx.globalAlpha = 1;   // 头像主体满对比：字符要"印"在银幕上，不是浮着
      for (let r = 0; r < maxRow; r++) {
        ctx.fillText(cropped[r], ox, oy + r * cellH + fs * 0.8);
      }
      ctx.globalAlpha = 1;
    }

    if (!reduced) {
      (function loop() {
        draw(performance.now() / 1000);
        requestAnimationFrame(loop);
      })();
    }
    if (window.ResizeObserver) new ResizeObserver(resize).observe(wrap!);
    resize();
  }
</script>
