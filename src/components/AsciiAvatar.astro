---
// ASCII 头像（构建时由 scripts/png2ascii.mjs 从 public/avatar.png 生成）
// 薄荷磷光字符 + CRT 扫描线 + 开机逐行显现
interface Props {
  prompt?: string;
}
const { prompt = 'bujianshu@sz ~ $' } = Astro.props;
---

<div class="aa-wrap">
  <canvas id="ascii-avatar" role="img" aria-label="ASCII 头像：由头像图转换的字符画"></canvas>
  <span class="aa-prompt">{prompt}</span>
</div>

<style>
  .aa-wrap {
    position: relative;
    background: #0a2228;
    border: 1px solid var(--panel-line);
    border-radius: 0;
    overflow: hidden;
  }
  #ascii-avatar {
    display: block;
    width: 100%;
    height: 190px;
  }
  .aa-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.18) 0 1px, transparent 1px 3px);
    box-shadow: inset 0 0 44px rgba(0, 0, 0, 0.5);
  }
  .aa-prompt {
    position: absolute;
    left: 8px;
    bottom: 6px;
    z-index: 2;
    font-size: 10px;
    color: rgba(143, 224, 205, 0.6);
    background: rgba(10, 34, 40, 0.75);
    padding: 2px 6px;
    border-radius: 0;
    pointer-events: none;
  }
</style>

<script>
  import asciiData from '../data/avatar-ascii.json';

  const wrap = document.querySelector('.aa-wrap');
  const canvas = document.getElementById('ascii-avatar') as HTMLCanvasElement | null;
  if (wrap && canvas && canvas.getContext) {
    const ctx = canvas.getContext('2d')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    const MONO = 'Consolas, Menlo, monospace';
    const art: string[] = (asciiData as { rows: string[] }).rows;
    let w = 0, h = 0, bootT: number | null = null;

    function resize() {
      w = wrap!.clientWidth;
      h = canvas!.clientHeight || 190;
      canvas!.width = Math.max(1, Math.round(w * DPR));
      canvas!.height = Math.max(1, Math.round(h * DPR));
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      draw(null); // 完整绘制；逐行显现动画只在非 reduced 的循环里生效
    }

    function draw(t: number | null) {
      if (!w || !h || !art.length) return;
      ctx.fillStyle = '#0a2228';
      ctx.fillRect(0, 0, w, h);
      const cols = art[0].length || 60;
      const rowsN = art.length;
      const fs = Math.max(4, Math.min(w / (cols * 0.6), (h / rowsN) / 1.12));
      const cellW = fs * 0.6;
      const cellH = fs * 1.12;
      const ox = (w - cols * cellW) / 2;
      const oy = (h - rowsN * cellH) / 2;
      ctx.font = fs + 'px ' + MONO;
      ctx.fillStyle = 'rgba(143,224,205,0.92)';
      let maxRow = rowsN;
      if (t !== null) {
        if (bootT === null) bootT = t;
        maxRow = Math.ceil(Math.min(1, (t - bootT) / 0.9) * rowsN);
      }
      for (let r = 0; r < maxRow; r++) {
        ctx.fillText(art[r], ox, oy + r * cellH + fs * 0.8);
      }
    }

    if (!reduced) {
      (function loop() {
        draw(performance.now() / 1000);
        requestAnimationFrame(loop);
      })();
    }
    if (window.ResizeObserver) new ResizeObserver(resize).observe(wrap!);
    resize();
  }
</script>
