---
// ASCII 头像（构建时由 scripts/png2ascii.mjs 从 public/avatar.png 生成）
// yetone 式"小银幕"：整版铺半调底网（屏幕点亮的底噪），脸部亮部把底网镂空（发光），
// 暗部实心色块压在底网之上；叠加扫描线 + CRT 缓慢下扫光带。
interface Props {
  prompt?: string;
}
const { prompt = 'bujianshu@sz ~ $' } = Astro.props;
---

<div class="aa-wrap">
  <canvas id="ascii-avatar" role="img" aria-label="ASCII 头像：由头像图转换的字符画"></canvas>
  <div class="aa-scan" aria-hidden="true"></div>
  <div class="aa-sweep" aria-hidden="true"></div>
  <span class="aa-prompt">{prompt}</span>
</div>

<style>
  .aa-wrap {
    position: relative;
    background: transparent;
    border: 1px solid var(--frame);
    border-radius: 0;
    overflow: hidden;
  }
  #ascii-avatar {
    display: block;
    width: 100%;
    height: 190px;
  }
  /* CRT 扫描线 */
  .aa-scan {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: repeating-linear-gradient(0deg, rgba(10, 30, 34, 0.07) 0 1px, transparent 1px 3px);
  }
  /* 缓慢下扫的光带（电视刷新感） */
  .aa-sweep {
    position: absolute;
    left: 0;
    right: 0;
    top: -22%;
    height: 20%;
    z-index: 3;
    pointer-events: none;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.16) 55%, transparent);
    animation: aaSweep 7s linear infinite;
  }
  @keyframes aaSweep {
    0% { top: -22%; }
    100% { top: 108%; }
  }
  /* 日场白幕：光带换成柔和的暗带才看得见 */
  :global([data-theme='light']) .aa-sweep {
    background: linear-gradient(180deg, transparent, rgba(20, 51, 58, 0.07) 55%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .aa-sweep { animation: none; }
  }
  .aa-prompt {
    position: absolute;
    left: 8px;
    bottom: 6px;
    z-index: 4;
    font-size: 10px;
    color: var(--ink-soft);
    opacity: 0.8;
    padding: 2px 6px;
    border-radius: 0;
    pointer-events: none;
  }
</style>

<script>
  import asciiData from '../data/avatar-ascii.json';

  const wrap = document.querySelector('.aa-wrap');
  const canvas = document.getElementById('ascii-avatar') as HTMLCanvasElement | null;
  if (wrap && canvas && canvas.getContext) {
    const ctx = canvas.getContext('2d')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    const MONO = 'Consolas, Menlo, monospace';
    const art: string[] = (asciiData as { rows: string[] }).rows;

    // 数据直接就是整版网格（背景 = '.' 底网标记），不再裁剪包围盒
    const cols = art[0].length;
    const rowsN = art.length;

    let w = 0, h = 0, bootT: number | null = null;

    function resize() {
      w = wrap!.clientWidth;
      h = canvas!.clientHeight || 190;
      canvas!.width = Math.max(1, Math.round(w * DPR));
      canvas!.height = Math.max(1, Math.round(h * DPR));
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      draw(null);
    }

    // 返回 true = 开机显影动画播完，可以停止逐帧重绘
    function draw(t: number | null): boolean {
      if (!w || !h || !rowsN) return true;
      const styles = getComputedStyle(wrap!);
      const ink = styles.getPropertyValue('--ink').trim() || '#14333b';

      // 实测 █ 字宽排版：块字符横向无缝拼成色面
      ctx.font = '10px ' + MONO;
      const adv10 = ctx.measureText('█').width || 6;
      const fs = Math.max(4, Math.min((w / cols) * (10 / adv10), h / rowsN / 1.02));
      const cellW = (adv10 * fs) / 10;
      const cellH = fs * 1.02;
      const ox = (w - cols * cellW) / 2;
      const oy = (h - rowsN * cellH) / 2;
      ctx.font = fs + 'px ' + MONO;
      ctx.textBaseline = 'alphabetic';

      ctx.clearRect(0, 0, w, h);

      // 1) 底网：整版低透明度 ░ —— "屏幕是点亮的"，头像从底网里显影
      const colsP = Math.ceil(w / cellW);
      const rowsP = Math.ceil(h / cellH);
      const meshLine = '░'.repeat(colsP);
      ctx.fillStyle = ink;
      ctx.globalAlpha = 0.13;
      for (let r = 0; r < rowsP; r++) {
        ctx.fillText(meshLine, 0, r * cellH + fs * 0.8);
      }
      ctx.globalAlpha = 1;

      // 2) 亮部镂空：数据里的空格 = 脸部/高光，把底网擦掉 → 比背景更亮（显像管发光感）
      for (let r = 0; r < rowsN; r++) {
        const row = art[r];
        for (let c = 0; c < row.length; c++) {
          if (row[c] === ' ') {
            ctx.clearRect(ox + c * cellW, oy + r * cellH, cellW + 0.6, cellH + 0.6);
          }
        }
      }

      // 3) 主体色块：满对比压上去（'.' 底网标记处不画，底网已铺）
      let maxRow = rowsN;
      let done = true;
      if (t !== null && !reduced) {
        if (bootT === null) bootT = t;
        const p = Math.min(1, (t - bootT) / 0.9);
        maxRow = Math.ceil(p * rowsN);
        done = p >= 1;
      }
      ctx.fillStyle = ink;
      for (let r = 0; r < maxRow; r++) {
        const line = art[r].replace(/\./g, ' ');
        if (line.trim()) ctx.fillText(line, ox, oy + r * cellH + fs * 0.8);
      }
      return done;
    }

    if (!reduced) {
      (function loop() {
        const done = draw(performance.now() / 1000);
        if (!done) requestAnimationFrame(loop);
      })();
    }
    // 主题切换后重绘（墨水是跟随主题的）
    new MutationObserver(() => draw(null)).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
    if (window.ResizeObserver) new ResizeObserver(resize).observe(wrap!);
    resize();
  }
</script>
