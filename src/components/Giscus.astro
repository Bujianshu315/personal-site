---
// giscus 评论：数据存本仓库 GitHub Discussions，零后端。
// 评论者需 GitHub 登录；加载失败或未装 App 时整块自动隐藏（message error 监听）。
const GISCUS_REPO = 'Bujianshu315/personal-site';
const GISCUS_REPO_ID = 'R_kgDOVnqxFw';
const GISCUS_CATEGORY = 'Announcements'; // 仅维护者可开帖，评论体验最干净
const GISCUS_CATEGORY_ID = 'DIC_kwDOVnqxF84DLRST';
---

<section class="giscus-wrap" id="giscus-wrap">
  <p class="giscus-kicker">┌─ 观后感 · 留言区</p>
  <div class="giscus-box" id="giscus-box"></div>
</section>

<script>
  const wrap = document.getElementById('giscus-wrap');
  const box = document.getElementById('giscus-box');

  const giscusTheme = () =>
    document.documentElement.dataset.theme === 'light' ? 'light' : 'dark_dimmed';

  function mount() {
    const s = document.createElement('script');
    s.src = 'https://giscus.app/client.js';
    s.async = true;
    s.crossOrigin = 'anonymous';
    s.setAttribute('data-repo', 'Bujianshu315/personal-site');
    s.setAttribute('data-repo-id', 'R_kgDOVnqxFw');
    s.setAttribute('data-category', 'Announcements');
    s.setAttribute('data-category-id', 'DIC_kwDOVnqxF84DLRST');
    s.setAttribute('data-mapping', 'pathname');
    s.setAttribute('data-strict', '1');
    s.setAttribute('data-reactions-enabled', '1');
    s.setAttribute('data-emit-metadata', '1');
    s.setAttribute('data-input-position', 'top');
    s.setAttribute('data-theme', giscusTheme());
    s.setAttribute('data-lang', 'zh-CN');
    box!.appendChild(s);
  }

  // giscus 致命错误（未装 App / 配置错）→ 静默隐藏整块。
  // 注意 "discussion not found" 是良性提示（首次评论时自动创建讨论），不能隐藏。
  window.addEventListener('message', (e) => {
    if (e.origin !== 'https://giscus.app') return;
    try {
      const m = typeof e.data === 'string' ? JSON.parse(e.data) : e.data;
      const err = m?.giscus?.error;
      if (err && !String(err).toLowerCase().includes('not found')) wrap!.style.display = 'none';
    } catch { /* 非 giscus 消息，忽略 */ }
  });

  // 站点深浅主题切换时同步评论区主题
  const themeObs = new MutationObserver(() => {
    const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    if (!iframe) return;
    iframe.contentWindow!.postMessage(
      { giscus: { setConfig: { theme: giscusTheme() } } },
      'https://giscus.app'
    );
  });
  themeObs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  mount();
</script>

<style>
  .giscus-wrap {
    margin-top: 40px;
    padding-top: 22px;
    border-top: 1px solid var(--frame);
  }
  .giscus-kicker {
    margin: 0 0 14px;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }
  .giscus-box {
    min-height: 120px;
    padding: 4px 6px 6px;
  }
  /* giscus 主题底色：iframe 是透明的，文字色按主题定，底色必须配套才能保对比度 */
  :global([data-theme='dark']) .giscus-box { background: #22272e; }
  :global([data-theme='light']) .giscus-box { background: #ffffff; }
</style>
