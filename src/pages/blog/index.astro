---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<Base title="场刊目录 · 博客 — Bujianshu" description="不见树的博客：项目记录、开发心得与随想。">
  <nav class="bk-nav">
    <a href="/">← 返回放映厅</a>
    <a href="/rss.xml" target="_blank" rel="noopener">RSS 订阅 ↗</a>
  </nav>

  <main class="paper">
    <header class="bk-head">
      <p class="bk-kicker">┌─ 场刊目录 · BLOG</p>
      <h1>写下的东西</h1>
      <p class="bk-sub">项目记录、开发心得与随想。不追热点，更新随缘。</p>
    </header>

    <div class="post-list">
      {posts.map((post) => (
        <a class="post-row" href={`/blog/${post.slug}/`}>
          <time>{fmt(post.data.pubDate)}</time>
          <div class="pr-main">
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <div class="pr-tags">
                {post.data.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            )}
          </div>
          <span class="pr-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>

    <p class="bk-foot">B-TV 场刊 · 由 Astro 内容集合驱动 · <a href="/">b-tv 主厅</a></p>
  </main>
</Base>

<style>
  /* 博客页需要整页滚动（主页把滚动锁在银幕内部，这里解开） */
  :global(html) { scroll-behavior: smooth; }
  :global(body) { overflow: auto; }

  /* 顶部导航：像素字体 Chrome */
  .bk-nav {
    display: flex;
    justify-content: space-between;
    max-width: 860px;
    margin: 18px auto 0;
    padding: 0 16px;
  }
  .bk-nav a {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--mint-soft);
    text-decoration: none;
  }
  .bk-nav a:hover { color: var(--pink); }

  /* 场刊纸面 */
  .paper {
    width: min(860px, calc(100% - 32px));
    margin: 26px auto 48px;
    padding: 44px 40px 36px;
    background: linear-gradient(165deg, var(--screen-a), var(--screen-b));
    color: var(--ink);
    border: 1.5px solid var(--screen-edge);
    box-shadow: 0 26px 70px rgba(0, 0, 0, 0.35);
  }

  .bk-head { padding-bottom: 20px; border-bottom: 1px solid var(--frame); }
  .bk-kicker { margin: 0; font-size: 11px; letter-spacing: 0.08em; color: var(--ink-soft); }
  .bk-head h1 { margin: 10px 0 0; font-size: 30px; font-weight: 600; letter-spacing: 0.04em; }
  .bk-sub { margin: 10px 0 0; font-size: 13px; color: var(--ink-soft); }

  /* 文章列表：阅读字体 */
  .post-list { display: flex; flex-direction: column; }
  .post-row {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    padding: 20px 4px;
    border-bottom: 1px dashed var(--frame);
    text-decoration: none;
    color: inherit;
  }
  .post-row time { flex: none; padding-top: 4px; font-size: 12px; letter-spacing: 0.06em; color: var(--pink-deep); }
  .pr-main { min-width: 0; flex: 1; }
  .pr-main h2 { margin: 0; font-size: 18px; font-weight: 600; line-height: 1.5; transition: color 0.15s; }
  .post-row:hover h2 { color: var(--pink-deep); }
  .pr-main p { margin: 6px 0 0; font-size: 13px; line-height: 1.75; color: var(--ink-soft); }
  .pr-tags { display: flex; gap: 6px; margin-top: 10px; flex-wrap: wrap; }
  .tag { font-size: 10.5px; padding: 2px 8px; border: 1px solid var(--frame); color: var(--ink-soft); }
  .pr-arrow { flex: none; padding-top: 4px; color: var(--ink-soft); transition: color 0.15s, transform 0.15s; }
  .post-row:hover .pr-arrow { color: var(--pink-deep); transform: translateX(3px); }

  .bk-foot {
    margin: 30px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--frame);
    font-size: 11px;
    color: var(--ink-soft);
    text-align: center;
  }
  .bk-foot a { color: var(--pink-deep); text-decoration: none; }
  .bk-foot a:hover { text-decoration: underline; }

  @media (max-width: 560px) {
    .paper { padding: 28px 20px; }
    .post-row { flex-direction: column; gap: 6px; }
    .post-row time { padding-top: 0; }
  }
</style>
