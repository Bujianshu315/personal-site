---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [featured, ...rest] = posts;

const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<Base title="场刊目录 · 博客 — Bujianshu" description="不见树的博客：项目记录、开发心得与随想。">
  <nav class="bk-nav">
    <a href="/">← 返回放映厅</a>
    <a href="/rss.xml" target="_blank" rel="noopener">RSS 订阅 ↗</a>
  </nav>

  <main class="paper">
    <header class="bk-head">
      <p class="bk-kicker">┌─ 场刊目录 · BLOG</p>
      <h1>放映室角落里不起眼的博客</h1>
      <p class="bk-sub">随缘更新</p>
    </header>

    <div class="post-list">
      {featured && (
        <a class="post-feature" href={`/blog/${featured.slug}/`}>
          <div class="pf-meta">
            {featured.data.tags.length > 0 && <span class="pf-cat">{featured.data.tags[0]}</span>}
            <i class="pf-line" aria-hidden="true"></i>
            <time>{fmt(featured.data.pubDate)}</time>
          </div>
          <h2>{featured.data.title}</h2>
          <p class="pf-desc">{featured.data.description}</p>
          <span class="pf-more">── 阅读全文</span>
        </a>
      )}

      {rest.length > 0 && (
        <div class="post-grid">
          {rest.map((post) => (
            <a class="post-cell" href={`/blog/${post.slug}/`}>
              <div class="pf-meta">
                {post.data.tags.length > 0 && <span class="pf-cat">{post.data.tags[0]}</span>}
                <i class="pf-line" aria-hidden="true"></i>
                <time>{fmt(post.data.pubDate)}</time>
              </div>
              <h3>{post.data.title}</h3>
              <p class="pf-desc">{post.data.description}</p>
              <span class="pf-more">── 阅读全文</span>
            </a>
          ))}
        </div>
      )}
    </div>

    <p class="bk-foot">© 2026 不见树 · 转载请注明出处 · <a href="/">b-tv 主厅</a> · <a href="/rss.xml">RSS</a></p>
  </main>
</Base>

<style>
  /* 博客页需要整页滚动（主页把滚动锁在银幕内部，这里解开） */
  :global(html) { scroll-behavior: smooth; }
  :global(body) { overflow: auto; }

  /* 顶部导航：像素字体 Chrome */
  .bk-nav {
    display: flex;
    justify-content: space-between;
    width: calc(100% - 156px);   /* 与主站银幕等宽（视口减两侧导轨） */
    margin: 18px auto 0;
    padding: 0 16px;
  }
  .bk-nav a {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--mint-soft);
    text-decoration: none;
  }
  .bk-nav a:hover { color: var(--pink); }

  /* 场刊纸面 */
  .paper {
    width: calc(100% - 156px);   /* 与主站银幕等宽 */
    min-height: calc(100dvh - 74px);  /* 与主站银幕等高：首屏正好铺满 */
    margin: 26px auto 48px;
    padding: 44px 48px 36px;
    background: linear-gradient(165deg, var(--screen-a), var(--screen-b));
    color: var(--ink);
    border: 1.5px solid var(--screen-edge);
    box-shadow: 0 26px 70px rgba(0, 0, 0, 0.35);
  }

  .bk-head { padding-bottom: 20px; border-bottom: 1px solid var(--frame); }
  .bk-kicker { margin: 0; font-size: 11px; letter-spacing: 0.08em; color: var(--ink-soft); }
  .bk-head h1 { margin: 10px 0 0; font-size: 30px; font-weight: 600; letter-spacing: 0.04em; }
  .bk-sub { margin: 10px 0 0; font-size: 13px; color: var(--ink-soft); }

  /* 文章列表：最新一篇做头条，其余进网格 */
  .post-list { display: flex; flex-direction: column; }

  /* 头条大卡 */
  .post-feature {
    display: block;
    padding: 26px 0 24px;
    border-bottom: 1px dashed var(--frame);
    text-decoration: none;
    color: inherit;
  }
  /* 「分类 ── 日期」一行 */
  .pf-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--pink-deep);
  }
  .pf-cat { color: var(--pink-deep); }
  .pf-line {
    display: inline-block;
    width: 44px;
    height: 1px;
    background: color-mix(in srgb, var(--pink-deep) 55%, transparent);
  }
  .pf-meta time { color: var(--ink-soft); }

  .post-feature h2 {
    margin: 12px 0 0;
    font-size: 23px;
    font-weight: 650;
    line-height: 1.45;
    transition: color 0.15s;
  }
  .post-feature:hover h2 { color: var(--pink-deep); }
  .pf-desc { margin: 10px 0 0; font-size: 13.5px; line-height: 1.8; color: var(--ink-soft); }
  .pf-more {
    display: inline-block;
    margin-top: 14px;
    font-size: 11.5px;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
    transition: color 0.15s;
  }
  .post-feature:hover .pf-more,
  .post-cell:hover .pf-more { color: var(--pink-deep); }

  /* 其余文章：三栏网格 */
  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    padding-top: 6px;
  }
  .post-cell {
    display: flex;
    flex-direction: column;
    padding: 22px 0 18px;
    text-decoration: none;
    color: inherit;
  }
  .post-cell h3 {
    margin: 10px 0 0;
    font-size: 16.5px;
    font-weight: 650;
    line-height: 1.5;
    transition: color 0.15s;
  }
  .post-cell:hover h3 { color: var(--pink-deep); }
  .post-cell .pf-desc { margin-top: 8px; font-size: 12.5px; line-height: 1.75; flex: 1; }
  .post-cell .pf-more { margin-top: 12px; }

  .bk-foot {
    margin: 30px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--frame);
    font-size: 11px;
    color: var(--ink-soft);
    text-align: center;
  }
  .bk-foot a { color: var(--pink-deep); text-decoration: none; }
  .bk-foot a:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .post-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .paper { width: calc(100% - 32px); min-height: calc(100dvh - 70px); padding: 28px 20px; }
    .bk-nav { width: calc(100% - 32px); }
    .post-grid { grid-template-columns: 1fr; gap: 0; }
    .post-cell { border-bottom: 1px dashed var(--frame); }
    .post-feature h2 { font-size: 20px; }
  }
</style>
